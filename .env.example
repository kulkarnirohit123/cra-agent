# =============================================================================
# CRA-AGENT Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=./data

# -----------------------------------------------------------------------------
# Git Repository to Monitor
# -----------------------------------------------------------------------------
GIT_REPO_PATH=./target-repo
GIT_BRANCHES=main,develop
GIT_POLL_INTERVAL_SECONDS=60

# -----------------------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------------------
# Supported: openai, anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (if using anthropic provider)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# -----------------------------------------------------------------------------
# Jira Integration
# -----------------------------------------------------------------------------
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_PROJECT_KEY=CRA
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token

# Jira Webhook
JIRA_WEBHOOK_SECRET=your-webhook-secret

# Jira Issue Type & Labels
JIRA_ISSUE_TYPE=Bug
JIRA_LABELS=cra-agent,security,vulnerability
JIRA_COMPONENT=Security

# -----------------------------------------------------------------------------
# Scanner Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of enabled scanners
SCANNERS_ENABLED=dependency,sast,secrets

# Scanner tool paths (if not in PATH)
SEMGREP_PATH=semgrep
PIP_AUDIT_PATH=pip-audit
GITLEAKS_PATH=gitleaks

# Severity threshold for reporting (critical, high, medium, low, info)
SEVERITY_THRESHOLD=medium

# -----------------------------------------------------------------------------
# EU Vulnerability Database (EUVD)
# -----------------------------------------------------------------------------
EUVD_API_KEY=
EUVD_BASE_URL=https://eu-vd.enisa.europa.eu/api/v1
EUVD_ORGANIZATION_ID=your-org-id
EUVD_DRY_RUN=true
EUVD_AUTO_SYNC=true
EUVD_REFRESH_INTERVAL_HOURS=4

# -----------------------------------------------------------------------------
# Suppression Store
# -----------------------------------------------------------------------------
SUPPRESSION_DB_PATH=./data/suppressions.db

# -----------------------------------------------------------------------------
# Webhook Server
# -----------------------------------------------------------------------------
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# -----------------------------------------------------------------------------
# Fixer Agent
# -----------------------------------------------------------------------------
FIXER_BRANCH_PREFIX=cra-agent/fix-
FIXER_AUTO_MERGE=false
FIXER_MAX_FILES_CHANGED=5

# -----------------------------------------------------------------------------
# CRA Compliance
# -----------------------------------------------------------------------------
CRA_SBOM_FORMAT=cyclonedx
CRA_REPORTING_AUTHORITY=BSI
CRA_REPORT_EXPLOITED_WITHIN_HOURS=24

# -----------------------------------------------------------------------------
# GitHub App Integration
# -----------------------------------------------------------------------------
# GitHub App ID (from GitHub App settings)
GITHUB_APP_ID=your-github-app-id

# GitHub App Installation ID (from installation URL)
GITHUB_INSTALLATION_ID=

# GitHub Webhook Secret (must match GitHub App webhook settings)
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Path to GitHub App private key file (PEM format)
GITHUB_PRIVATE_KEY_PATH=./cra-agent.private-key.pem

# GitHub API URL (for GitHub Enterprise, use your instance URL)
GITHUB_API_URL=https://api.github.com

# Path to multi-repo configuration file
GITHUB_REPOS_CONFIG=./config/repos.yaml
